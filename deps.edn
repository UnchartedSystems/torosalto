{:paths ["src/shared" "src/server" "resources"]

 :deps
 {org.clojure/clojure
  {:mvn/version "1.12.0"}
  metosin/malli
  {:mvn/version "0.20.2"}
  cheshire/cheshire
  {:mvn/version "5.13.0"}
  buddy/buddy-sign
  {:mvn/version "3.6.1-359"}
  hato/hato
  {:mvn/version "1.0.0"}}
 

 :aliases
 {:test
  {:extra-paths ["test"]
   :main-opts ["-m" "torosalto.test-runner"]}

  :server
  {:extra-paths ["src/server"]
   :main-opts ["=m" "torosalto.server"]}

  :play
  {:main-opts ["-X" "torosalto.cli/start"]}
  
  :cljs
  {:extra-paths ["src/client"]
   :extra-deps
   {org.clojure/clojurescript
    {:mvn/version "1.12.134"}
    thheller/shadow-cljs
    {:mvn/version "3.5.0"}}}
  
  :main-opts ["-m" "shadow.cljs.devtools.cli"]}}

